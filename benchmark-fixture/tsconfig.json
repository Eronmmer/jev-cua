{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "WebWorker"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": ["./.wrangler/types/runtime.d.ts"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", ".wrangler/types/runtime.d.ts"]
}
