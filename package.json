{
  "name": "jev-cua",
  "version": "0.1.0",
  "private": true,
  "description": "Production local Cua + TypeSafe Jev fast-path runtime for Codex and Waku",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run format:check",
    "dev": "tsx src/server.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate:plugin": "python3 /Users/erons/.codex/skills/.system/plugin-creator/scripts/validate_plugin.py .",
    "validate:skill": "python3 /Users/erons/.codex/skills/.system/skill-creator/scripts/quick_validate.py skills/jev-cua-fastpath"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@typesafe-ai/sdk": "0.6.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.17.0",
    "prettier": "3.6.2",
    "tsup": "8.5.0",
    "tsx": "4.20.3",
    "typescript": "5.9.2"
  }
}
